syntax on

let mapleader = " "
set tabstop=4 softtabstop=4
set shiftwidth=4
set expandtab
set smartindent
set nu rnu
set nowrap
set incsearch
set ignorecase
set smartcase
set clipboard=unnamed
set autoread
set scrolloff=999
" change ctrl-w to ;
nnoremap <Leader>; ;
nnoremap ; <C-w>

" autocmd Filetype latex setlocal ts=2 sw=2 expandtab
